L 0x6afa apunta_el_objeto_en_la_lista_de_tres
L 0x6b0d busca_en_la_lista_de_tres
L 0x6b12 recorre_la_lista_de_tres
L 0x6d7a apunta_el_objeto_en_la_lista_de_cinco
L 0x6d8e busca_un_sprite_retirado
