L 0x693b corre_un_sprite
C 0x693b la fila del sprite
C 0x693c ocho arriba
C 0x693e si se sale de la banda util
C 0x6942 0xC3: fuera de la pantalla
C 0x6946 ocho hacia abajo
C 0x6948 el bit 1 cambia el sentido
C 0x694c u ocho hacia arriba
C 0x6950 cuatro bytes por sprite


